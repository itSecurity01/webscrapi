# Copy this file to .env and adjust as needed.

# Path to the Excel file with product URLs
INPUT_XLSX=input/products.xlsx

# Playwright
HEADLESS=true
NAV_TIMEOUT_MS=30000

# Concurrency
PRODUCT_CONCURRENCY=1
IMAGE_CONCURRENCY=5

# Max images downloaded per product (some sites' galleries include every
# color variant's shots on one page — 30+ images for what you'd call "one
# product"). 0 = unlimited. product.json still records `imagesFound` (the
# real count before this cap) so you can tell "site only had 2 photos" apart
# from "we capped it at 10 out of 30".
MAX_IMAGES_PER_PRODUCT=10

# Skip downloading images entirely (still records every image URL found on
# the page in product.json, just with success:false/error:"skipped" and no
# local file). Useful when only the URLs are needed (e.g. the upload
# pipeline reads image URLs straight from product.json). Same as --skip-images.
SKIP_IMAGES=false

# Per-domain politeness delay between requests (ms), plus random jitter added on top
DOMAIN_DELAY_MS=800
DOMAIN_DELAY_JITTER_MS=400

# Retries
MAX_RETRIES=2

# --- Review server (npm run review) ---
REVIEW_SERVER_PORT=4000

# --- Uploader (npm run upload) ---
# Endpoint that accepts one product payload per POST (see src/uploader.js).
# Leave UPLOAD_API_URL unset and use --dry-run until you have real values.
UPLOAD_API_URL=
UPLOAD_API_KEY=
# Header + scheme used to send UPLOAD_API_KEY. Defaults produce:
#   Authorization: Bearer <UPLOAD_API_KEY>
# Set UPLOAD_AUTH_SCHEME= (empty) to send the raw key with no scheme prefix.
UPLOAD_AUTH_HEADER=Authorization
UPLOAD_AUTH_SCHEME=Bearer

# --- Campaign document defaults (npm run combine-uploads / to-mongo-import) ---
# ObjectId of the "user" this batch of shared/store campaigns should be
# attributed to (campaignSchema.userId). Not schema-required, but left
# unset means every generated document has no owner — set it to import
# for a real account. See src/transform/toCampaignDocument.js.
DEFAULT_CAMPAIGN_USER_ID=

# --- Direct-to-MongoDB uploader (npm run upload-mongo) ---
# Alternative to the REST uploader above: inserts output/combined_uploads.json
# straight into MongoDB through the real Mongoose campaign model
# (src/models/Campaign.js), so program/categories get cast to real ObjectId
# values and schema validation (required/enum/min/max) runs before insert.
MONGODB_URI=
